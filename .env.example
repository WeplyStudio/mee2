# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Server-Side Telegram Bot Notification Credentials
# These secrets are strictly executed in backend Node.js (server.ts) and NEVER sent to the browser bundle.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
