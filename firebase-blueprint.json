{
  "entities": {
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Individual visitor pageview event log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique event id" },
        "visitorId": { "type": "string", "description": "Anonymous unique visitor identifier" },
        "path": { "type": "string", "description": "Visited page path" },
        "referrer": { "type": "string", "description": "HTTP referrer origin" },
        "deviceType": { "type": "string", "description": "Device category: desktop, mobile, or tablet" },
        "browser": { "type": "string", "description": "Detected browser name" },
        "timestamp": { "type": "string", "description": "ISO timestamp of the visit" }
      },
      "required": ["visitorId", "path", "timestamp"]
    },
    "AnalyticsSummary": {
      "title": "AnalyticsSummary",
      "description": "Aggregated daily or overall visitor metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Summary doc id" },
        "totalPageviews": { "type": "number", "description": "Total cumulative page views" },
        "totalUniqueVisitors": { "type": "number", "description": "Total unique visitors count" },
        "updatedAt": { "type": "string", "description": "Last update ISO timestamp" }
      },
      "required": ["totalPageviews", "totalUniqueVisitors"]
    },
    "PortfolioProject": {
      "title": "PortfolioProject",
      "description": "Portfolio project item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Project unique slug or id" },
        "title": { "type": "string", "description": "Project title" },
        "subtitle": { "type": "string", "description": "Short project tagline or subtitle" },
        "description": { "type": "string", "description": "Main summary of the project" },
        "category": { "type": "string", "description": "Category or industry domain" },
        "year": { "type": "string", "description": "Year of release or completion" },
        "client": { "type": "string", "description": "Client or company name" },
        "role": { "type": "string", "description": "Role performed in project" },
        "link": { "type": "string", "description": "Live URL preview link" },
        "github": { "type": "string", "description": "GitHub repository URL" },
        "imageUrl": { "type": "string", "description": "Cover thumbnail image URL" },
        "tags": { "type": "string", "description": "Comma-separated or list of tags" },
        "featured": { "type": "boolean", "description": "Featured on homepage" },
        "order": { "type": "number", "description": "Display order index" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["title", "description", "category"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global custom image and configuration overrides",
      "type": "object",
      "properties": {
        "heroImage": { "type": "string", "description": "Hero profile portrait image URL" },
        "aboutImage": { "type": "string", "description": "About section portrait image URL" },
        "zyloImage": { "type": "string", "description": "Zylo project cover image URL" },
        "trufinImage": { "type": "string", "description": "Trufin project cover image URL" },
        "krigstudioImage": { "type": "string", "description": "Krig Studio project cover image URL" },
        "marqueeImages": { "type": "string", "description": "JSON serialized array of visual curation images" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      }
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Collaborators and team members assigned to projects",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique collaborator id" },
        "name": { "type": "string", "description": "Full name of member" },
        "role": { "type": "string", "description": "Assigned task or role" },
        "status": { "type": "string", "description": "Current status: Completed, In Progress, or Pending" },
        "avatar": { "type": "string", "description": "Avatar photo URL" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["name", "role", "status"]
    },
    "DashboardReminder": {
      "title": "DashboardReminder",
      "description": "Admin schedule and reminders",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique reminder id" },
        "title": { "type": "string", "description": "Reminder title" },
        "time": { "type": "string", "description": "Scheduled time" },
        "actionUrl": { "type": "string", "description": "Target action link" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["title", "time"]
    }
  },
  "firestore": {
    "/analytics_events/{eventId}": {
      "schema": "AnalyticsEvent",
      "description": "Individual visitor session records"
    },
    "/analytics_summary/{summaryId}": {
      "schema": "AnalyticsSummary",
      "description": "Cumulative traffic summaries"
    },
    "/portfolio_projects/{projectId}": {
      "schema": "PortfolioProject",
      "description": "Portfolio projects collection"
    },
    "/site_settings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Global site image overrides"
    },
    "/team_members/{memberId}": {
      "schema": "TeamMember",
      "description": "Team collaborators collection"
    },
    "/dashboard_reminders/{reminderId}": {
      "schema": "DashboardReminder",
      "description": "Dashboard schedule reminders"
    }
  }
}
