rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Portfolio projects can be read publicly; writes allowed for admin management
    match /portfolio_projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    // Site settings & image overrides can be read publicly
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Team members collaboration collection
    match /team_members/{memberId} {
      allow read: if true;
      allow write: if true;
    }

    // Dashboard reminders and schedule
    match /dashboard_reminders/{reminderId} {
      allow read: if true;
      allow write: if true;
    }

    // Analytics: visitors can log pageviews; reading/updating is permitted for dashboard
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read: if true;
      allow delete: if true;
    }

    match /analytics_summary/{summaryId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
